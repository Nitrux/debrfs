#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2022-2025 <Nitrux Latinoamericana S.C. <hello@nxos.org>>


# -- Exit on errors.

set -eu


# -- Set program name and version.

TOOL_NAME="Debrfs"
CONFIG_SOURCE=""
COMMAND=""
DEBUG_BOOTSTRAP=0
BOOTSTRAP_TEMP_KEYRING=""
BOOTSTRAP_TEMP_KEY_DOWNLOAD=""


# -- Define the default configuration directory.

DEFAULT_CONFIG_DIR=/etc/debrfs.d


# -- Print messages to stderr.

puts_info() {
	if [ -n "$1" ]; then
		printf "%s: \e[34mInfo:\e[0m %s\n" "$TOOL_NAME" "$*" >&2
	fi
}


# -- Print success messages to stderr.

puts_success() {
	if [ -n "$1" ]; then
		printf "%s: \e[32mSuccess:\e[0m %s\n" "$TOOL_NAME" "$*" >&2
	fi
}


# -- Print error messages to stderr.

puts_error() {
	if [ -n "$1" ]; then
		printf "%s: \e[31mError:\e[0m %b\n" "$TOOL_NAME" "$*" >&2
	fi
}


# -- Print messages or text using multiple lines to stderr.

print_message() {
    if [ $# -eq 0 ]; then
        printf "\n" >&2
    else
        printf "%s\n" "$@" >&2
    fi
}


# -- Print warning messages to stderr.

puts_warning() {
    if [ -n "$1" ]; then
        printf "%s: \e[33mWarning:\e[0m %s\n" "$TOOL_NAME" "$*" >&2
    fi
}


# -- Parse command-line arguments.

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --conf)
                if [[ $# -lt 2 ]]; then
                    puts_error "Missing argument for --conf."
                    exit 1
                fi
                CONFIG_SOURCE="$2"
                shift 2
                ;;
            --conf=*)
                CONFIG_SOURCE="${1#*=}"
                shift
                ;;
            --dbg-db)
                DEBUG_BOOTSTRAP=1
                shift
                ;;
            create|help)
                if [[ -n "$COMMAND" ]]; then
                    puts_error "Multiple commands provided."
                    exit 1
                fi
                COMMAND="$1"
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                puts_error "Unknown option '$1'."
                exit 1
                ;;
            *)
                if [[ -z "$COMMAND" ]]; then
                    COMMAND="$1"
                    shift
                else
                    puts_error "Unexpected argument '$1'."
                    exit 1
                fi
                ;;
        esac
    done

    if [[ $# -gt 0 ]]; then
        puts_error "Unexpected arguments after '--'."
        exit 1
    fi
}


# -- Load and validate a single configuration file.

load_config_file() {
    local config_file="$1"

    if [[ ! -r "$config_file" ]]; then
        puts_error "Configuration file not found or not readable: $config_file"
        exit 1
    fi

    puts_info "Loading configuration from $config_file..."

    if grep -nEv '^[[:space:]]*(#.*)?$|^[A-Z_][A-Z0-9_]*=.*$' "$config_file"; then
        puts_error "Invalid configuration file format in $config_file. Only variable assignments are allowed."
        exit 1
    fi

    if grep -E '[;&|$`]' "$config_file" | grep -vE '^[[:space:]]*#'; then
        puts_error "Configuration file $config_file contains potentially dangerous characters (;, &, |, \$, \`)."
        exit 1
    fi

    # shellcheck source=/dev/null
    . "$config_file"
}


# -- Load and validate configuration sources.

load_config() {
    local -a config_files=()
    local nullglob_was_set=0

    if shopt -q nullglob; then
        nullglob_was_set=1
    fi
    shopt -s nullglob

    if [[ -n "$CONFIG_SOURCE" ]]; then
        if [[ -d "$CONFIG_SOURCE" ]]; then
            config_files=("$CONFIG_SOURCE"/*.conf)
        else
            config_files=("$CONFIG_SOURCE")
        fi
    elif [[ -d "$DEFAULT_CONFIG_DIR" ]]; then
        config_files=("$DEFAULT_CONFIG_DIR"/*.conf)
    fi

    if [[ $nullglob_was_set -eq 0 ]]; then
        shopt -u nullglob
    fi

    if [[ ${#config_files[@]} -eq 0 ]]; then
        puts_error "No configuration files found."
        exit 1
    fi

    for config_file in "${config_files[@]}"; do
        load_config_file "$config_file"
    done

    local required_vars=("ROOTFS_VARIANT" "ROOTFS_ARCH" "ROOTFS_SUITE" "ROOTFS_DIR" "ROOTFS_MIRROR")
    for var in "${required_vars[@]}"; do
        if [[ -z "${!var:-}" ]]; then
            puts_error "Required variable $var is not set in configuration."
            exit 1
        fi
    done

    if [[ -n "${ROOTFS_KEYRING:-}" ]] && [[ ! -r "$ROOTFS_KEYRING" || ( ! -f "$ROOTFS_KEYRING" && ! -d "$ROOTFS_KEYRING" ) ]]; then
        puts_error "ROOTFS_KEYRING does not point to a readable keyring file or directory: $ROOTFS_KEYRING"
        exit 1
    fi

    if [[ -n "${ROOTFS_KEYRING:-}" && -n "${ROOTFS_KEYRING_URL:-}" ]]; then
        puts_error "Set only one of ROOTFS_KEYRING or ROOTFS_KEYRING_URL."
        exit 1
    fi

    if [[ -n "${ROOTFS_KEYRING_URL:-}" ]]; then
        local -a key_urls=()
        local key_url
        IFS=',' read -r -a key_urls <<< "$ROOTFS_KEYRING_URL"
        for key_url in "${key_urls[@]}"; do
            if [[ "$key_url" != https://* ]]; then
                puts_error "Every ROOTFS_KEYRING_URL entry must use HTTPS."
                exit 1
            fi
        done
    fi

    puts_success "Configuration loaded successfully."
}


# -- Download and prepare repository keyrings when key URLs are configured.

prepare_keyring() {
    if [[ -z "${ROOTFS_KEYRING_URL:-}" && -z "${ROOTFS_KEYRING:-}" ]]; then
        return 0
    fi

    BOOTSTRAP_TEMP_KEYRING="$(mktemp -d /var/tmp/debrfs-keyring.XXXXXX)"
    chmod 755 "$BOOTSTRAP_TEMP_KEYRING"

    if [[ -n "${ROOTFS_KEYRING:-}" ]]; then
        if [[ -d "$ROOTFS_KEYRING" ]]; then
            cp -a -- "$ROOTFS_KEYRING"/. "$BOOTSTRAP_TEMP_KEYRING"/
        else
            cp -- "$ROOTFS_KEYRING" "$BOOTSTRAP_TEMP_KEYRING/keyring.gpg"
        fi
        find "$BOOTSTRAP_TEMP_KEYRING" -type d -exec chmod 755 {} +
        find "$BOOTSTRAP_TEMP_KEYRING" -type f -exec chmod 644 {} +
        return 0
    fi

    if ! command -v curl >/dev/null 2>&1; then
        puts_error "curl is required to download ROOTFS_KEYRING_URL."
        exit 1
    fi

    if ! command -v gpg >/dev/null 2>&1; then
        puts_error "gpg is required to prepare ROOTFS_KEYRING_URL."
        exit 1
    fi

    local -a key_urls=()
    local key_url
    local key_index=0
    IFS=',' read -r -a key_urls <<< "$ROOTFS_KEYRING_URL"

    for key_url in "${key_urls[@]}"; do
        BOOTSTRAP_TEMP_KEY_DOWNLOAD="$(mktemp /var/tmp/debrfs-keyring-download.XXXXXX)"

        if ! curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
            --output "$BOOTSTRAP_TEMP_KEY_DOWNLOAD" "$key_url"; then
            puts_error "Failed to download repository key: $key_url"
            exit 1
        fi

        if ! gpg --batch --yes --dearmor --output "$BOOTSTRAP_TEMP_KEYRING/key-$key_index.gpg" "$BOOTSTRAP_TEMP_KEY_DOWNLOAD"; then
            puts_error "Failed to convert a downloaded repository key into a keyring."
            exit 1
        fi

        chmod 644 "$BOOTSTRAP_TEMP_KEYRING/key-$key_index.gpg"
        rm -f "$BOOTSTRAP_TEMP_KEY_DOWNLOAD"
        BOOTSTRAP_TEMP_KEY_DOWNLOAD=""
        ((key_index += 1))
    done
}


# -- Cleanup function to remove temporary directories.

cleanup() {
    if [[ -n "${ROOTFS_DIR:-}" ]] && [[ -d "$ROOTFS_DIR" ]] && [[ "${KEEP_ROOTFS:-false}" != "true" ]]; then
        puts_info "Cleaning up temporary directory: $ROOTFS_DIR"
        rm -rf "$ROOTFS_DIR"
    fi

    if [[ -n "$BOOTSTRAP_TEMP_KEY_DOWNLOAD" ]]; then
        rm -f "$BOOTSTRAP_TEMP_KEY_DOWNLOAD"
    fi

    if [[ -n "$BOOTSTRAP_TEMP_KEYRING" ]]; then
        rm -rf "$BOOTSTRAP_TEMP_KEYRING"
    fi
}


# -- Function to create tar archive.

create_archive() {
    local tar_path="$1"
    
    puts_info "Creating compressed archive at $tar_path..."
    
    local compression_tool="${COMPRESSION_TOOL:-xz}"
    local compression_level="${COMPRESSION_LEVEL:-9}"
    local tar_opts=(
        -I "$compression_tool -$compression_level"
        -cf "$tar_path"
        --exclude="var/cache/apt/archives"
    )

    if [[ $DEBUG_BOOTSTRAP -eq 1 ]]; then
        tar_opts=(-I "$compression_tool -$compression_level" -cvf "$tar_path" --exclude="var/cache/apt/archives")
    fi
    
    if ! (cd "$ROOTFS_DIR" && tar "${tar_opts[@]}" .); then
        puts_error "Failed to create archive."
        return 1
    fi
    
    return 0
}


# -- Function to display help message.

show_help() {
    cat <<EOF

Description:
    Create Debian rootfs TAR files with mmdebstrap.

Report bugs at: https://github.com/Nitrux/nuts/issues.

Usage: $(basename "$0") [--conf FILE|DIR] [--dbg-db] <command>

Commands:
  create    Create and compress the root filesystem (rootfs) with mmdebstrap.
  help      Display this help message.

Examples:
  sudo $(basename "$0") create
  sudo $(basename "$0") create --conf /etc/debrfs.d/minbase-testing-no-systemd.conf
  sudo $(basename "$0") create --dbg-db
EOF
}


# -- Function to create the root filesystem.

create_rootfs() {
    puts_info "Starting root filesystem creation process..."

    local base_name="${TAR_NAME_BASE:-${TAR_FILE:-rootfs}}"
    TAR_FILE="${base_name}-$(date +%Y.%m.%d-%H.%M).tar.xz"

    if ! command -v mmdebstrap >/dev/null 2>&1; then
        puts_error "mmdebstrap is not installed. Install it before creating a rootfs."
        exit 1
    fi

    if [[ -d "$ROOTFS_DIR" ]]; then
        puts_warning "Directory exists. Cleaning: $ROOTFS_DIR"
        if ! rm -rf -- "$ROOTFS_DIR"; then
            puts_error "Failed to clean directory: $ROOTFS_DIR"
            exit 1
        fi
    fi

    puts_info "Creating rootfs directory: $ROOTFS_DIR"
    if ! mkdir -p "$ROOTFS_DIR"; then
        puts_error "Failed to create directory: $ROOTFS_DIR"
        exit 1
    fi

    puts_info "Running mmdebstrap (this may take a while)..."
    puts_info "Variant: $ROOTFS_VARIANT | Arch: $ROOTFS_ARCH | Suite: $ROOTFS_SUITE"

    prepare_keyring

    local -a mmdebstrap_cmd=(
        mmdebstrap
        --mode=root
        --format=directory
        --variant="$ROOTFS_VARIANT"
        --architectures="$ROOTFS_ARCH"
    )

    local bootstrap_keyring="$BOOTSTRAP_TEMP_KEYRING"
    if [[ -n "$bootstrap_keyring" ]]; then
        mmdebstrap_cmd+=(
            --keyring="$bootstrap_keyring"
            --setup-hook="mkdir -p \"\$1/etc/apt/trusted.gpg.d\" && cp -a \"$bootstrap_keyring\"/. \"\$1/etc/apt/trusted.gpg.d/\""
        )
    fi

    if [[ -n "${ROOTFS_KEYRING:-}${ROOTFS_KEYRING_URL:-}" ]]; then
        mmdebstrap_cmd+=(
            --skip=check/signed-by
            --aptopt='Apt::Key::gpgvcommand "/usr/bin/gpgv"'
        )
    fi

    if [[ -n "${ROOTFS_INCLUDE:-}" ]]; then
        mmdebstrap_cmd+=(--include="$ROOTFS_INCLUDE")
    fi

    if [[ -n "${ROOTFS_REPOSITORY_PRIORITIES:-}" ]]; then
        local -a repository_priorities=()
        local repository_priority
        local repository_origin
        local priority
        IFS=',' read -r -a repository_priorities <<< "$ROOTFS_REPOSITORY_PRIORITIES"

        for repository_priority in "${repository_priorities[@]}"; do
            if [[ "$repository_priority" != *:* ]]; then
                puts_error "ROOTFS_REPOSITORY_PRIORITIES entries must use host:priority format."
                exit 1
            fi

            repository_origin="${repository_priority%%:*}"
            priority="${repository_priority##*:}"
            if [[ ! "$repository_origin" =~ ^[A-Za-z0-9.-]+$ || ! "$priority" =~ ^-?[0-9]+$ ]]; then
                puts_error "Invalid repository priority entry: $repository_priority"
                exit 1
            fi

            mmdebstrap_cmd+=(
                --setup-hook="mkdir -p \"\$1/etc/apt/preferences.d\" && printf 'Package: *\\nPin: origin %s\\nPin-Priority: %s\\n\\n' '$repository_origin' '$priority' >> \"\$1/etc/apt/preferences.d/98debrfs-repository-priorities\""
            )
        done
    fi

    if [[ -n "${ROOTFS_EXCLUDE:-}" ]]; then
        local excluded_packages="${ROOTFS_EXCLUDE//,/ }"
        local package
        for package in $excluded_packages; do
            if [[ ! "$package" =~ ^[a-z0-9][a-z0-9+.-]*(:[a-z0-9]+)?$ ]]; then
                puts_error "Invalid package name in ROOTFS_EXCLUDE: $package"
                exit 1
            fi
        done

        mmdebstrap_cmd+=(
            --setup-hook="mkdir -p \"\$1/etc/apt/preferences.d\" && printf 'Package: %s\\nPin: version *\\nPin-Priority: -1\\n' '$excluded_packages' > \"\$1/etc/apt/preferences.d/99debrfs-exclude\""
            --customize-hook="rm -f \"\$1/etc/apt/preferences.d/99debrfs-exclude\""
        )
    fi

    local -a mirrors=()
    local mirror
    IFS=',' read -r -a mirrors <<< "$ROOTFS_MIRROR"
    for mirror in "${mirrors[@]}"; do
        if [[ -z "$mirror" ]]; then
            puts_error "ROOTFS_MIRROR contains an empty mirror entry."
            exit 1
        fi
    done

    mmdebstrap_cmd+=("$ROOTFS_SUITE" "$ROOTFS_DIR" "${mirrors[@]}")

    local bootstrap_log=""
    if [[ $DEBUG_BOOTSTRAP -eq 0 ]]; then
        bootstrap_log="$(mktemp /var/tmp/debrfs-mmdebstrap.XXXXXX.log)"
    fi

    if [[ $DEBUG_BOOTSTRAP -eq 1 ]]; then
        if ! "${mmdebstrap_cmd[@]}"; then
            puts_error "mmdebstrap failed while creating the base system. The output above shows the failing step."
            exit 1
        fi
    elif ! "${mmdebstrap_cmd[@]}" >"$bootstrap_log" 2>&1; then
        puts_error "mmdebstrap failed while creating the base system. The last output lines are below."
        tail -n 20 "$bootstrap_log" >&2
        rm -f "$bootstrap_log"
        exit 1
    fi

    if [[ -n "$bootstrap_log" ]]; then
        rm -f "$bootstrap_log"
    fi

    puts_success "mmdebstrap completed successfully."

    local final_dir="${OUTPUT_DIR:-$PWD}"

    if [[ ! -d "$final_dir" ]]; then
        puts_info "Creating output directory: $final_dir"
        mkdir -p "$final_dir"
    fi

    local temp_tar_path
    temp_tar_path="$(dirname "$ROOTFS_DIR")/$(basename "$TAR_FILE")"

    local final_tar_path
    final_tar_path="$final_dir/$(basename "$TAR_FILE")"

    if [[ -f "$final_tar_path" ]]; then
        puts_warning "Archive already exists at $final_tar_path. Removing..."
        rm -f "$final_tar_path"
    fi

    if ! create_archive "$temp_tar_path"; then
        puts_error "Failed to create archive."
        exit 1
    fi

    puts_info "Moving archive to $final_tar_path..."
    if ! mv "$temp_tar_path" "$final_tar_path"; then
        puts_error "Failed to move archive to destination."
        exit 1
    fi

    puts_success "Root filesystem archive created at $final_tar_path"

    if command -v du >/dev/null 2>&1; then
        local size
        size=$(du -h "$final_tar_path" | cut -f1)
        puts_info "Archive size: $size"
    fi
}

# -- Parse arguments before loading configuration.

parse_args "$@"


# -- Display help before any privileged actions or configuration loading.

if [[ "$COMMAND" == "help" ]]; then
    show_help
    exit 0
fi


# -- Check if running with root privileges or ask for sudo.

(( EUID != 0 )) && exec sudo -- "$0" "$@"


# -- Load configuration before setting up trap.

load_config


# -- Set up cleanup trap after configuration is loaded.

trap cleanup EXIT ERR


# -- Main script logic.

if [[ -z "$COMMAND" ]]; then
    puts_error "No command provided."
    show_help
    exit 1
fi

case "$COMMAND" in
    create)
        create_rootfs
        ;;
    help)
        show_help
        ;;
    *)
        puts_error "Unknown command '$COMMAND'."
        show_help
        exit 1
        ;;
esac
